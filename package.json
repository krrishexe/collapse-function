{
  "name": "collapse-functions",
  "displayName": "Collapse Functions",
  "description": "Collapse and expand all function expressions and declarations in JavaScript and TypeScript files",
  "version": "1.0.0",
  "publisher": "krishyadav",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "collapse-functions.collapseAllFunctions",
        "title": "Collapse All Functions"
      },
      {
        "command": "collapse-functions.expandAllFunctions",
        "title": "Expand All Functions"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krishyadav/vscode-collapse-functions-extension"
  },
  "keywords": [
    "fold",
    "collapse",
    "function",
    "javascript",
    "typescript"
  ],
  "license": "MIT"
}
